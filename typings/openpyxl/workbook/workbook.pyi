from collections.abc import Iterator
from pathlib import Path
from typing import IO, Any

from openpyxl.chartsheet.chartsheet import Chartsheet
from openpyxl.styles.named_styles import NamedStyle
from openpyxl.workbook.defined_name import DefinedName, DefinedNameDict, DefinedNameList
from openpyxl.workbook.properties import CalcProperties
from openpyxl.worksheet.worksheet import Worksheet

class Workbook:
    def __contains__(self, key: object) -> bool: ...
    def __delitem__(self, key: str) -> None: ...
    def __getitem__(self, key: str) -> Worksheet: ...
    def __iter__(self) -> Iterator[Worksheet]: ...
    def __init__(self, write_only: bool = ..., iso_dates: bool = ...) -> None: ...
    def add_named_range(self, named_range: DefinedName) -> None: ...
    def add_named_style(self, style: NamedStyle) -> None: ...
    @property
    def calculation(self) -> CalcProperties | None: ...
    @calculation.setter
    def calculation(self, value: CalcProperties | None) -> None: ...
    @property
    def chartsheets(self) -> list[Chartsheet]: ...
    def close(self) -> None: ...
    def copy_worksheet(self, from_worksheet: Worksheet) -> Worksheet: ...
    def create_chartsheet(
        self,
        title: str | None = ...,
        index: int | None = ...,
    ) -> Chartsheet: ...
    def create_named_range(
        self,
        name: str,
        worksheet: Worksheet | None = ...,
        value: str | None = ...,
        scope: int | None = ...,
    ) -> None: ...
    def create_sheet(
        self,
        title: str | int | None = ...,
        index: int | None = ...,
    ) -> Worksheet: ...
    @property
    def data_only(self) -> bool: ...
    @property
    def defined_names(self) -> DefinedNameDict: ...
    @defined_names.setter
    def defined_names(self, value: DefinedNameDict | DefinedNameList) -> None: ...
    @property
    def excel_base_date(self) -> float: ...
    def get_named_ranges(self) -> list[DefinedName]: ...
    def index(self, worksheet: Worksheet) -> int: ...
    @property
    def mime_type(self) -> str: ...
    def move_sheet(self, sheet: str | Worksheet, offset: int = ...) -> None: ...
    @property
    def named_styles(self) -> list[str]: ...
    @property
    def read_only(self) -> bool: ...
    def remove(self, worksheet: Worksheet | Chartsheet) -> None: ...
    def save(self, filename: str | Path | IO[bytes]) -> None: ...
    @property
    def sheetnames(self) -> list[str]: ...
    @property
    def worksheets(self) -> list[Worksheet]: ...
    @property
    def write_only(self) -> bool: ...
    @property
    def active(self) -> Worksheet: ...
    @active.setter
    def active(self, value: Worksheet | int | None) -> None: ...
    # Common internal/test attributes used by fillxl and tests.
    _sheets: list[Any]
    _active_sheet_index: int
    style: Any
    security: Any
